{
  "name": "@repro/sdk",
  "version": "0.0.1",
  "description": "Repro SDK — identify users, mark events, and capture component state",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig-build.json",
    "test": "tsx --experimental-test-module-mocks --test src/**/*.test.ts",
    "fmt": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reprohq/repro.git"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^3.2.3",
    "tsx": "4.19.3",
    "typescript": "overridden"
  }
}

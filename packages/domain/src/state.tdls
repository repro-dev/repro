# StateEventType values alias SourceEventType values 60-65 from event.tdls.
# These must stay in sync — each struct's type tag is dispatched at the
# SourceEvent level, not via a nested StateEvent wrapper.
type StateEventType: enum<uint8> {
  ReactCommit: 60
  ReduxDispatch: 61
  VueComponentUpdate: 62
  VuexMutation: 63
  VuexAction: 64
  PiniaAction: 65
}

type ReactCommitEvent: struct {
  0) type: StateEventType.ReactCommit
  1) time: uint64
  2) frameId: uint32
  3) componentName: string
  4) propsDelta: string
  5) hooksDelta: string
  6) fiberNodeId: uint32
}

type ReduxDispatchEvent: struct {
  0) type: StateEventType.ReduxDispatch
  1) time: uint64
  2) frameId: uint32
  3) actionType: string
  4) actionPayload: string
  5) stateDiff: string
}

type VueComponentUpdateEvent: struct {
  0) type: StateEventType.VueComponentUpdate
  1) time: uint64
  2) frameId: uint32
  3) componentName: string
  4) uid: uint32
  5) propsDelta: string
  6) setupStateDelta: string
}

type VuexMutationEvent: struct {
  0) type: StateEventType.VuexMutation
  1) time: uint64
  2) frameId: uint32
  3) mutationType: string
  4) payload: string
  5) stateDiff: string
}

type VuexActionEvent: struct {
  0) type: StateEventType.VuexAction
  1) time: uint64
  2) frameId: uint32
  3) actionType: string
  4) payload: string
}

type PiniaActionEvent: struct {
  0) type: StateEventType.PiniaAction
  1) time: uint64
  2) frameId: uint32
  3) storeId: string
  4) actionName: string
  5) args: string
  6) stateDiff: string
}

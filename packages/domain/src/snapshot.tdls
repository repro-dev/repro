import interaction.{PointerState, ScrollMap}
import point.Point
import react.{ReactComponentTree}
import vdom.VTree
import vdom.CapturedStyleSheet

type InteractionSnapshot: struct {
  0) pointer: Point
  1) pointerState: PointerState
  2) scroll: ScrollMap
  3) viewport: Point
  4) pageURL: string
}

type FrameworkState: struct {
  0) reactTree: ?ReactComponentTree
  1) reduxState: ?string
}

type Snapshot: struct {
  0) dom: ?VTree
  1) interaction: ?InteractionSnapshot
  2) frameworkState: ?FrameworkState
  3) cssRules: ?vector<CapturedStyleSheet>
  4) colorScheme: ?string
}

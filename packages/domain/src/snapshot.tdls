import interaction.{PointerState, ScrollMap}
import point.Point
import vdom.VTree

type InteractionSnapshot: struct {
  0) pointer: Point
  1) pointerState: PointerState
  2) scroll: ScrollMap
  3) viewport: Point
  4) pageURL: string
}

type ReactComponentNode: struct {
  0) fiberNodeId: uint32
  1) parentFiberId: uint32
  2) componentName: string
  3) props: string
}

type ReactComponentTree: struct {
  0) nodes: vector<ReactComponentNode>
}

type FrameworkState: struct {
  0) reactTree: ?ReactComponentTree
  1) reduxState: ?string
}

type Snapshot: struct {
  0) dom: ?VTree
  1) interaction: ?InteractionSnapshot
  2) frameworkState: ?FrameworkState
}

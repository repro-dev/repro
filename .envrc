# Make reproctl available as a bare command from anywhere in the repo.
# Worktrees get their own tracked copy of this file, so it works there too.
#
# Prerequisites (one-time):
#   1. brew bundle                        # installs direnv
#   2. eval "$(direnv hook zsh)"          # add to ~/.zshrc (or your shell's rc)
#   3. direnv allow                       # trust this .envrc
# postgresql@17 is keg-only; add its bin/ so psql, pg_dump, etc. are available
PATH_add /opt/homebrew/opt/postgresql@17/bin

# Expose repo-local workspace binaries (like `linear`) inside repo shells.
PATH_add node_modules/.bin
PATH_add bin

# Binaries from proto toolchain
PATH_add $PROTO_HOME/bin

# Default OpenCode profile for bare `reproctl opencode`.
export REPRO_OPENCODE_PROFILE=openai-gpt5.6-luna-only

# Load machine-local overrides (e.g. OPENCODE_CONFIG_CONTENT written by
# `reproctl setup`). The file is gitignored and not required to exist.
source_env_if_exists .envrc.local

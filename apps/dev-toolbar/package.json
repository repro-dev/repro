{
  "name": "@repro/dev-toolbar",
  "version": "1.0.0",
  "description": "A toolbar for local development",
  "main": "index.js",
  "scripts": {
    "build": "BUILD_ENV=production ./scripts/build",
    "build:standalone": "BUILD_ENV=production MODE=standalone ./scripts/build",
    "watch": "./scripts/build -w",
    "fmt": "prettier --write src",
    "test": "tsx --experimental-test-module-mocks --test --test-timeout=30000 --test-force-exit src/**/*.test.ts{,x}",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@jsxstyle/react": "^3.0.1",
    "@repro/atom": "workspace:*",
    "@repro/date-utils": "workspace:*",
    "@repro/design": "workspace:*",
    "@repro/devtools": "workspace:*",
    "@repro/diagnostics": "workspace:*",
    "@repro/domain": "workspace:*",
    "@repro/future-utils": "workspace:*",
    "@repro/logger": "workspace:*",
    "@repro/messaging": "workspace:*",
    "@repro/playback": "workspace:*",
    "@repro/random-string": "workspace:*",
    "@repro/recording": "workspace:*",
    "@repro/source-utils": "workspace:*",
    "@repro/std": "workspace:*",
    "@repro/tdl": "workspace:*",
    "@repro/theme": "workspace:*",
    "@repro/wire-formats": "workspace:*",
    "detect-browser": "^5.3.0",
    "fluture": "^14.0.0",
    "lucide-react": "^0.277.0",
    "pretty-bytes": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.8",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.176",
    "@types/expect": "^24.3.2",
    "@types/node": "22.14.0",
    "@types/react": "^18.0.14",
    "@types/react-dom": "^18.0.5",
    "@types/react-window": "^1.8.5",
    "@types/repro-shared-types": "workspace:*",
    "@vitejs/plugin-react": "overridden",
    "expect": "^29.7.0",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^3.2.3",
    "tsx": "4.19.3",

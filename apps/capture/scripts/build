#!/usr/bin/env bash

set -euo pipefail

project_dir=$(realpath "$(dirname $0)/..")
source_dir="$project_dir/src"
build_dir="$project_dir/dist"

watch=false

while getopts "w" param; do
  case "$param" in
    w) watch=true;;
  esac
done

mkdir -p "$build_dir"

cp -r "$source_dir/extension/static/"* "$build_dir/"

entries="background content bridgeHost runtime capture"

if [ "$watch" = true ]; then
  for entry in $entries; do
    VITE_ENTRY="$entry" pnpm exec vite build --watch &
  done
  wait
else
  for entry in $entries; do
    VITE_ENTRY="$entry" pnpm exec vite build
  done
fi

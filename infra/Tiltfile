# Unified Tilt orchestrator
#
# A single Tilt process manages all services — main checkout and
# worktrees — from one instance. The `scripts/reproctl.sh` CLI
# writes reproctl_services.json with the resolved service list; this
# Tiltfile reads it and registers everything generically.
#
# Backwards compatibility: when no reproctl_services.json exists, the
# original `tilt up <group>` workflow works exactly as before via
# the legacy groups path.

load(
  './tilt-lib/services.Tiltfile',
  'register_service',
  'register_ingress',
  'resolve_dependencies',
  'SERVICES',
)
load(
  './tilt-lib/worktree.Tiltfile',
  'is_worktree',
)
load('ext://helm_resource', 'helm_resource', 'helm_repo')

config.define_string_list('groups', args=True)
cfg = config.parse()

PROJECT_ROOT = os.path.join(os.getcwd(), '..')
INFRA_DIR = os.getcwd()
TMP_DIR = os.path.join(PROJECT_ROOT, 'tmp')
CONFIG_FILE = os.path.join(TMP_DIR, 'reproctl_services.json')

update_settings(
  k8s_upsert_timeout_secs=300
)

allow_k8s_contexts('kind')

# Watch reproctl_services.json so that changes from `reproctl`
# trigger an automatic Tiltfile re-evaluation.
watch_file(CONFIG_FILE)


def has_config_file():
  result = str(local(
    'test -f "%s" && echo yes || echo no' % CONFIG_FILE,
    quiet=True,
  ))
  return result.strip() == 'yes'


def load_service_config():
  """Load the service list from reproctl_services.json.

  Returns a list of dicts: [{name, source, slug}, ...]
  - name: service key in SERVICES (e.g. 'api-server')
  - source: absolute path to the source tree (or '.' for main checkout)
  - slug: worktree slug (empty string for main checkout)
  """
  if not has_config_file():
    return []

  data = read_json(CONFIG_FILE)
  return data.get('services', [])


def register_shared_infra():
  """Register shared infrastructure resources.

  Database, object storage, and ingress controller are singletons
  shared across all services regardless of source tree.
  """
  load_dynamic('./apps/data/Tiltfile')
  load_dynamic('./apps/gateway/Tiltfile')


# ── Service registration ────────────────────────────────────────────

service_config = load_service_config()

if service_config:
  # Unified mode: services come from reproctl_services.json, written by
  # `scripts/reproctl.sh`. Each entry specifies which service to
  # run and from which source tree.
  #
  # Shared infrastructure (database, storage, ingress) is registered
  # once. Main-checkout services use per-app Tiltfiles for full
  # feature parity (db-reset, etc.). Worktree services use the
  # generic register_service() from services.Tiltfile.

  service_config = resolve_dependencies(service_config)

  register_shared_infra()

  wt_sources_seen = {}
  wt_slugs_with_services = {}

  for entry in service_config:
    name = entry.get('name', '')
    source = entry.get('source', '.')
    slug = entry.get('slug', '')

    if slug:
      if name not in SERVICES:
        warn('Unknown worktree service in reproctl_services.json: %s. Known: %s' % (name, ', '.join(SERVICES.keys())))
        continue

      wt_path = source if source.startswith('/') else os.path.join(PROJECT_ROOT, source)

      if wt_path not in wt_sources_seen:
        wt_sources_seen[wt_path] = slug
        local_resource(
          'dependencies-wt-' + slug,
          cmd='pnpm fetch && pnpm install --offline',
          dir=wt_path,
          deps=[os.path.join(wt_path, 'pnpm-lock.yaml')],
          labels=['wt.' + slug],
        )

      register_service(name, slug, wt_path, INFRA_DIR)

      if slug not in wt_slugs_with_services:
        wt_slugs_with_services[slug] = []
      wt_slugs_with_services[slug].append(name)

    else:
      if name == 'api-server':
        load_dynamic('./apps/api-server/Tiltfile')
      elif name == 'workspace':
        load_dynamic('./apps/workspace/Tiltfile')
      elif name == 'admin':
        load_dynamic('./apps/admin/Tiltfile')
      elif name == 'capture':
        load_dynamic('./apps/capture/Tiltfile')
      elif name == 'dev-toolbar':
        load_dynamic('./apps/dev-toolbar/Tiltfile')
      else:
        warn('No per-app Tiltfile for main checkout service: %s' % name)

  has_main_services = False
  for entry in service_config:
    if not entry.get('slug', ''):
      has_main_services = True
      break

  if has_main_services:
    local_resource(
      'dependencies',
      cmd='pnpm fetch && pnpm install --offline',
      dir='..',
      deps=['pnpm-lock.yaml'],
      labels=['infra'],
    )

  for slug, svc_names in wt_slugs_with_services.items():
    register_ingress(slug, svc_names, INFRA_DIR)

else:
  # Legacy mode: no reproctl_services.json, original `tilt up <group>` behaviour.
  # This path is identical to the pre-REP-219 main checkout mode.

  if is_worktree(PROJECT_ROOT):
    fail(
      'Worktree detected but no reproctl_services.json found.\n' +
      'Use `scripts/reproctl.sh start <service>` to configure and start Tilt,\n' +
      'or create tmp/reproctl_services.json manually.\n\n' +
      'Direct `tilt up` from a worktree is no longer supported.\n' +
      'The unified orchestrator runs from the main checkout.'
    )

  groups = {
    'capture-only': [
      'capture'
    ],

    'dev-toolbar-only': [
      'dev-toolbar'
    ],

    'api-server': [
      'storage',
      'database',
      'api-server',
      'gateway-ingress',
    ],

    'workspace': [
      'storage',
      'database',
      'api-server',
      'workspace',
      'gateway-ingress',
    ]
  }

  resources = []

  for arg in cfg.get('groups', []):
    if arg in groups:
      resources += groups[arg]
    else:
      resources.append(arg)

  config.set_enabled_resources(resources)

  local_resource(
    'dependencies',
    cmd='pnpm fetch && pnpm install --offline',
    dir='..',
    deps=['pnpm-lock.yaml'],
    labels=['infra'],
  )

  # Extensions
  load_dynamic('./apps/capture/Tiltfile')
  load_dynamic('./apps/dev-toolbar/Tiltfile')

  # Data
  load_dynamic('./apps/data/Tiltfile')

  # APIs
  load_dynamic('./apps/api-server/Tiltfile')

  # Apps
  load_dynamic('./apps/workspace/Tiltfile')

  # Infra
  load_dynamic('./apps/gateway/Tiltfile')

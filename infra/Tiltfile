# Unified Tilt orchestrator
#
# A single Tilt process manages all services — main checkout and
# worktrees — from one instance. The `scripts/reproctl.sh` CLI
# writes reproctl_services.json with the resolved service list; this
# Tiltfile reads it and registers everything generically.

load(
  './tilt-lib/services.Tiltfile',
  'register_service',
  'register_local_service',
  'resolve_dependencies',
  'service_watch_ignores',
  'service_watch_paths',
  'wt_label',
)

PROJECT_ROOT = os.path.join(os.getcwd(), '..')
INFRA_DIR = os.getcwd()
TMP_DIR = os.path.join(PROJECT_ROOT, 'tmp')
CONFIG_FILE = os.path.join(TMP_DIR, 'reproctl_services.json')
SERVICES = read_json('./services.json')

update_settings(
  k8s_upsert_timeout_secs=300
)

allow_k8s_contexts('kind')

# Watch reproctl_services.json so that changes from `reproctl`
# trigger an automatic Tiltfile re-evaluation.
watch_file(CONFIG_FILE)


def has_config_file():
  result = str(local(
    'test -f "%s" && echo yes || echo no' % CONFIG_FILE,
    quiet=True,
  ))
  return result.strip() == 'yes'


def load_service_config():
  """Load the service list from reproctl_services.json.

  Returns a list of dicts: [{name, source, slug}, ...]
  - name: service key in SERVICES (e.g. 'api-server')
  - source: absolute path to the source tree (or '.' for main checkout)
  - slug: worktree slug (empty string for main checkout)
  """
  if not has_config_file():
    return []

  data = read_json(CONFIG_FILE)
  return data.get('services', [])


def register_shared_infra():
  """Register shared infrastructure resources.

  Database, object storage, and ingress controller are singletons
  shared across all services regardless of source tree.
  """
  load_dynamic('./apps/data/Tiltfile')
  load_dynamic('./apps/gateway/Tiltfile')


# ── Service registration ────────────────────────────────────────────

service_config = load_service_config()

if service_config:
  # Unified mode: services come from reproctl_services.json, written by
  # `scripts/reproctl.sh`. Each entry specifies which service to
  # run and from which source tree.
  #
  # Shared infrastructure (database, storage, ingress) is registered
  # once. Main-checkout services use the generic registration paths.
  # Worktree services use register_service() from services.Tiltfile.

  for entry in service_config:
    slug = entry.get('slug', '')
    source = entry.get('source', '.')
    if slug:
      wt_path = source if source.startswith('/') else os.path.join(PROJECT_ROOT, source)
      wt_services_file = os.path.join(wt_path, 'infra', 'services.json')
      result = str(local(
        'test -f "%s" && echo yes || echo no' % wt_services_file,
        quiet=True,
      ))
      if result.strip() == 'yes':
        wt_services = read_json(wt_services_file)
        for k, v in wt_services.items():
          if k not in SERVICES:
            SERVICES[k] = v
          else:
            for field, val in v.items():
              if field not in SERVICES[k] or SERVICES[k][field] == None:
                SERVICES[k][field] = val

  service_config = resolve_dependencies(service_config, SERVICES)

  register_shared_infra()

  service_slugs = {}
  for entry in service_config:
    slug = entry.get('slug', '')
    name = entry.get('name', '')
    if slug not in service_slugs:
      service_slugs[slug] = {}
    service_slugs[slug][name] = slug

  wt_sources_seen = {}

  for entry in service_config:
    name = entry.get('name', '')
    source = entry.get('source', '.')
    slug = entry.get('slug', '')

    if slug:
      if name not in SERVICES:
        warn('Unknown worktree service in reproctl_services.json: %s. Known: %s' % (name, ', '.join(SERVICES.keys())))
        continue

      wt_path = source if source.startswith('/') else os.path.join(PROJECT_ROOT, source)

      if wt_path not in wt_sources_seen:
        wt_sources_seen[wt_path] = slug
        local_resource(
          'dependencies-wt-' + slug,
          cmd='pnpm fetch && pnpm install --offline',
          dir=wt_path,
          deps=[os.path.join(wt_path, 'pnpm-lock.yaml')],
          labels=[wt_label(slug)],
        )

      svc = SERVICES[name]
      if svc.get('portless_name'):
        register_service(name, SERVICES[name], slug, wt_path, INFRA_DIR, service_slugs)
      else:
        register_local_service(name, SERVICES[name], INFRA_DIR, slug, wt_path, service_slugs)

    else:
      svc = SERVICES[name]
      # api-server has a dedicated per-app Tiltfile for its migration/seed/reset resources
      if name == 'api-server':
        load_dynamic('./apps/api-server/Tiltfile')
      elif svc.get('portless_name'):
        # Portless main-checkout service: register inline using base portless_name directly.
        # register_service() requires a non-empty slug (wt_name/wt_label break with slug=""),
        # so we inline the local_resource registration here.
        portless_name = svc['portless_name']
        serve_env = dict(svc.get('serve_env', {}))
        for env_key in svc.get('env_passthrough', []):
          serve_env[env_key] = os.getenv(env_key, '')
        resource_deps = list(svc.get('resource_deps', []))
        local_resource(
          name,
          serve_cmd=svc['serve_cmd'],
          serve_dir=PROJECT_ROOT,
          serve_env=serve_env,
          deps=service_watch_paths(svc, PROJECT_ROOT),
          ignore=service_watch_ignores(svc, PROJECT_ROOT),
          resource_deps=resource_deps,
          allow_parallel=True,
          links=['http://' + portless_name + '.localhost:1355'],
          labels=list(svc.get('labels', ['app'])),
        )
      elif svc.get('type', 'k8s') == 'local':
        register_local_service(name, svc, INFRA_DIR)
      else:
        warn('No registration path for main checkout service: %s' % name)

  has_main_services = False
  for entry in service_config:
    if not entry.get('slug', ''):
      has_main_services = True
      break

  if has_main_services:
    local_resource(
      'dependencies',
      cmd='pnpm fetch && pnpm install --offline',
      dir='..',
      deps=['pnpm-lock.yaml'],
      labels=['infra'],
    )

else:
  fail(
    'No reproctl_services.json found at: ' + CONFIG_FILE + '\n' +
    'Use `reproctl start <service>` to start services.\n' +
    'Direct `tilt up` without reproctl is no longer supported.'
  )

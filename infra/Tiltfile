load(
  './tilt-lib/worktree.Tiltfile',
  'is_worktree',
  'detect_main_checkout',
  'worktree_slug',
  'register_worktree_dependencies',
  'register_worktree_service',
  'register_worktree_ingress',
  'SERVICES',
)
load('ext://helm_resource', 'helm_resource', 'helm_repo')

config.define_string_list('groups', args=True)
cfg = config.parse()

PROJECT_ROOT = os.path.join(os.getcwd(), '..')
WORKTREE_MODE = is_worktree(PROJECT_ROOT)

update_settings(
  k8s_upsert_timeout_secs=300
)

allow_k8s_contexts('kind')

if WORKTREE_MODE:
  # Worktree mode
  #
  # When `tilt up` runs from inside a git worktree, shared infrastructure
  # (database, storage, ingress controller) is automatically provisioned
  # from the main checkout's charts. Worktree-specific services get their
  # own Docker builds, Helm releases, and ingress routes.
  #
  # Usage:
  #   cd ../repro-wt-feat-new-api
  #   tilt up api-server          # isolated api-server from this worktree
  #   tilt up api-server workspace # both services isolated
  #
  # Hostnames follow the pattern:
  #   app.wt-<slug>.repro.localhost
  #   api.wt-<slug>.repro.localhost
  #
  # Routing note: services NOT listed on the `tilt up` command line
  # are routed to the main checkout's k8s Services via the ingress
  # fallback (e.g. api-server-service, workspace-service). This means
  # the main checkout's Tilt must be running with those services
  # enabled for cross-service requests to succeed. For example:
  #
  #   tilt up workspace            # workspace is isolated; API calls
  #                                # go to the main checkout's api-server.
  #                                # Requires `tilt up api-server` in the
  #                                # main checkout.
  #
  #   tilt up api-server workspace # fully self-contained; no dependency
  #                                # on the main checkout's services.

  MAIN_CHECKOUT = detect_main_checkout(PROJECT_ROOT)
  MAIN_INFRA = os.path.join(MAIN_CHECKOUT, 'infra')
  WT_SLUG = worktree_slug(PROJECT_ROOT)

  requested = cfg.get('groups', [])

  services = []
  for arg in requested:
    if arg in SERVICES:
      services.append(arg)
    else:
      warn('Unknown service for worktree mode: %s. Known: %s' % (arg, ', '.join(SERVICES.keys())))

  if not services:
    fail(
      'Worktree mode requires at least one service as an argument.\n' +
      'Usage: tilt up <service> [...]\n' +
      'Available services: %s' % ', '.join(SERVICES.keys())
    )

  # Shared infrastructure — loaded from the main checkout so that
  # database, storage, and ingress controller are available even if the
  # main checkout's Tilt isn't running.

  # Database + object storage (PostgreSQL, SeaweedFS)
  load_dynamic(os.path.join(MAIN_INFRA, 'apps/data/Tiltfile'))

  local_resource(
    'database-ready',
    cmd='kubectl wait --namespace default --for=condition=ready pod -l app.kubernetes.io/instance=database,app.kubernetes.io/name=postgresql --timeout=120s',
    resource_deps=['database'],
    labels=['infra']
  )

  local_resource(
    'storage-ready',
    cmd='kubectl wait --namespace default --for=jsonpath="{.subsets[*].addresses[*].ip}" endpoints/storage-seaweedfs-s3 --timeout=120s',
    resource_deps=['storage'],
    labels=['infra']
  )

  # Ingress controller only (NOT the main checkout's gateway chart,
  # which would deploy ingress objects for app/api.repro.localhost
  # that conflict with the worktree's own ingress).

  helm_repo(
    'ingress-nginx',
    'https://kubernetes.github.io/ingress-nginx',
    labels=['infra']
  )

  helm_resource(
    name='ingress-controller',
    chart='ingress-nginx/ingress-nginx',
    namespace='default',
    flags=[
      '--set=controller.config.use-http2=false',
      '--set=controller.hostPort.enabled=true',
      '--set=controller.service.type=NodePort'
    ],
    resource_deps=['ingress-nginx'],
    labels=['infra']
  )

  local_resource(
    'ingress-admission-ready',
    cmd='kubectl wait --namespace default --for=condition=available deployment/ingress-controller-ingress-nginx-controller --timeout=120s && kubectl wait --namespace default --for=jsonpath="{.subsets[*].addresses[*].ip}" endpoints/ingress-controller-ingress-nginx-controller-admission --timeout=120s',
    resource_deps=['ingress-controller'],
    labels=['infra']
  )

  # Worktree-specific services
  register_worktree_dependencies(WT_SLUG, PROJECT_ROOT)

  for svc in services:
    register_worktree_service(svc, WT_SLUG, PROJECT_ROOT, MAIN_INFRA)

  register_worktree_ingress(WT_SLUG, services, MAIN_INFRA)

else:
  # Main checkout mode (original behaviour)

  groups = {
    'capture-only': [
      'capture'
    ],

    'dev-toolbar-only': [
      'dev-toolbar'
    ],

    'api-server': [
      'storage',
      'database',
      'api-server',
      'gateway-ingress',
    ],

    'workspace': [
      'storage',
      'database',
      'api-server',
      'workspace',
      'gateway-ingress',
    ]
  }

  resources = []

  for arg in cfg.get('groups', []):
    if arg in groups:
      resources += groups[arg]
    else:
      resources.append(arg)

  config.set_enabled_resources(resources)

  local_resource(
    'dependencies',
    cmd='pnpm fetch && pnpm install --offline',
    dir='..',
    deps=['pnpm-lock.yaml'],
    labels=['infra'],
  )

  # Extensions
  load_dynamic('./apps/capture/Tiltfile')
  load_dynamic('./apps/dev-toolbar/Tiltfile')

  # Data
  load_dynamic('./apps/data/Tiltfile')

  # APIs
  load_dynamic('./apps/api-server/Tiltfile')

  # Apps
  load_dynamic('./apps/workspace/Tiltfile')

  # Infra
  load_dynamic('./apps/gateway/Tiltfile')

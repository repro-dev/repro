{
  "api-server": {
    "type": "local",
    "moon_project": "repro/api-server",
    "app_dir": "apps/api-server",
    "serve_cmd": "portless api.repro moon run repro/api-server:dev",
    "serve_env": {
      "DB_HOST": "localhost",
      "DB_PORT": "15432",
      "DB_NAME": "repro",
      "DB_USER": "repro",
      "DB_PASSWORD": "repro",
      "STORAGE_ENDPOINT": "http://localhost:18333",
      "REPRO_APP_URL": "https://app.repro.localhost:1355",
      "REPRO_API_URL": "https://api.repro.localhost:1355",
      "BILLING_DEFAULT_PLAN": "Free",
      "RATE_LIMIT_UNAUTHENTICATED_RPM": "60",
      "RATE_LIMIT_AUTHENTICATED_RPM": "600",
      "RATE_LIMIT_UPLOAD_RPM": "20",
      "RATE_LIMIT_REDIS_URL": "redis://localhost:6379"
    },
    "env_passthrough": [
      "OPENROUTER_API_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ],
    "resource_deps": ["dependencies", "portless-proxy", "redis-ready"],
    "portless_name": "api.repro",
    "migrations": {
      "moon_task": "repro/api-server:migrate",
      "resource_deps": ["database-ready", "storage-ready"]
    },
    "seed": {
      "pnpm_package": "@repro/api-server",
      "resource_deps": ["storage-s3-forward"]
    },
    "deps": []
  },
  "workspace": {
    "type": "local",
    "moon_project": "repro/workspace",
    "app_dir": "apps/workspace",
    "serve_cmd": "portless app.repro moon run repro/workspace:dev",
    "serve_env": {
      "BUILD_ENV": "development",
      "REPRO_APP_URL": "https://app.repro.localhost:1355",
      "REPRO_API_URL": "https://api.repro.localhost:1355"
    },
    "resource_deps": ["dependencies", "portless-proxy"],
    "labels": ["app"],
    "portless_name": "app.repro",
    "deps": ["api-server"]
  },
  "admin": {
    "type": "local",
    "moon_project": "repro/admin",
    "app_dir": "apps/admin",
    "serve_cmd": "portless admin.repro moon run repro/admin:dev",
    "serve_env": {
      "BUILD_ENV": "development",
      "REPRO_WORKSPACE_URL": "https://app.repro.localhost:1355",
      "REPRO_ADMIN_URL": "https://admin.repro.localhost:1355",
      "REPRO_API_URL": "https://api.repro.localhost:1355"
    },
    "resource_deps": ["dependencies", "portless-proxy"],
    "labels": ["app"],
    "portless_name": "admin.repro",
    "deps": ["api-server"]
  },
  "capture": {
    "type": "local",
    "moon_project": "repro/capture",
    "app_dir": "apps/capture",
    "serve_cmd": "moon run repro/capture:watch",
    "serve_env": {
      "BUILD_ENV": "development",
      "REPRO_APP_URL": "https://app.repro.localhost:1355",
      "REPRO_API_URL": "https://api.repro.localhost:1355",
      "AGENTIC_MAX_ITERATIONS": "25"
    },
    "resource_deps": ["dependencies"],
    "labels": ["extension"],
    "deps": ["workspace"]
  },
  "dev-toolbar": {
    "type": "local",
    "moon_project": "repro/dev-toolbar",
    "app_dir": "apps/dev-toolbar",
    "serve_cmd": "moon run repro/dev-toolbar:watch",
    "serve_env": {},
    "resource_deps": ["dependencies"],
    "labels": ["extension"],
    "deps": ["workspace"]
  },
  "storybook-ui": {
    "type": "local",
    "moon_project": "repro/storybook-ui",
    "app_dir": "apps/storybook-ui",
    "serve_cmd": "moon run repro/storybook-ui:dev",
    "serve_env": {
      "BROWSER": "none"
    },
    "resource_deps": ["dependencies"],
    "labels": ["design"],
    "port": 6006,
    "deps": []
  },
  "marketing": {
    "type": "local",
    "moon_project": "repro/marketing",
    "app_dir": "apps/marketing",
    "serve_cmd": "portless marketing.repro moon run repro/marketing:dev",
    "serve_env": {
      "BUILD_ENV": "development",
      "REPRO_APP_URL": "https://app.repro.localhost:1355",
      "REPRO_MARKETING_URL": "https://marketing.repro.localhost:1355"
    },
    "resource_deps": ["dependencies", "portless-proxy"],
    "labels": ["app"],
    "portless_name": "marketing.repro",
    "deps": []
  }
}

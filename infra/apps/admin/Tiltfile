PROJECT_ROOT = os.path.join(os.getcwd(), '../../..')

load('../../tilt-lib/dependency_graph.Tiltfile', 'dependency_sync_paths', 'dependency_watch_paths', 'non_dependency_ignore_patterns')

docker_build(
  'admin',
  PROJECT_ROOT,
  dockerfile='../../Dockerfile',
  target='admin',
  build_args={
    'MOON_SCAFFOLD_PROJECTS': 'repro/admin',
  },
  entrypoint=["moon", "run", "repro/admin:dev"],
  ignore=[
    'infra',
    'dist',
    'build',
    'node_modules',
  ] + non_dependency_ignore_patterns('repro/admin', PROJECT_ROOT) + [
    '**/*.test.ts',
    '**/*.test.tsx',
    '**/*.spec.ts',
    '**/*.spec.tsx',
    '**/fixtures/**',
    '**/mocks/**',
    '**/test-data/**',
    '**/*.stories.tsx',
    '**/*.stories.ts',
    '**/*.demo.tsx',
    '**/*.md',
    '*.md',
    '*.MD',
    '.DS_Store',
    '*.swp',
    '*.swo',
    '*~',
    '*.log',
  ],
  live_update=[
    fall_back_on([
      os.path.join(PROJECT_ROOT, 'apps/admin/package.json'),
      os.path.join(PROJECT_ROOT, 'apps/admin/moon.yml'),
      os.path.join(PROJECT_ROOT, 'apps/admin/tsconfig.json'),
    ] + dependency_watch_paths('repro/admin', PROJECT_ROOT) + [
      os.path.join(PROJECT_ROOT, 'pnpm-lock.yaml'),
    ]),
    sync(
      os.path.join(PROJECT_ROOT, 'apps/admin/src'),
      '/app/apps/admin/src'
    ),
  ] + [
    sync(path, '/app/' + path.removeprefix(PROJECT_ROOT + '/'))
    for path in dependency_sync_paths('repro/admin', PROJECT_ROOT)
  ]
)

k8s_yaml(helm(
  './chart',
  name='admin',
  set=[
    'container.image=admin',
    'vars.REPRO_ADMIN_URL=http://admin.repro.localhost',
    'vars.REPRO_APP_URL=http://app.repro.localhost',
    'vars.REPRO_API_URL=http://api.repro.localhost',
    'vars.PORT=8080'
  ]
))

k8s_resource(
  'admin-deployment',
  new_name='admin',
  links=[
    'https://admin.repro.localhost',
  ],
  labels=['app']
)

PROJECT_ROOT = os.path.join(os.getcwd(), '../../..')

local_resource(
    'api-server-migrations',
    cmd='moon run repro/api-server:migrate --no-cache && pnpm --filter @repro/api-server run seed',
    dir=PROJECT_ROOT,
    env={
        'DB_HOST': 'localhost',
        'DB_PORT': '15432',
        'DB_NAME': 'repro',
        'DB_USER': 'repro',
        'DB_PASSWORD': 'repro',
        'STORAGE_ENDPOINT': 'http://localhost:18333',
        'STORAGE_KEY_PREFIX': '',
    },
    resource_deps=['database-ready', 'storage-ready'],
    labels=['api'],
)

local_resource(
    'db-reset',
    cmd='pnpm --filter @repro/api-server run reset-db && pnpm --filter @repro/api-server run seed',
    dir=PROJECT_ROOT,
    env={
        'DB_HOST': 'localhost',
        'DB_PORT': '15432',
        'DB_NAME': 'repro',
        'DB_USER': 'repro',
        'DB_PASSWORD': 'repro',
        'STORAGE_ENDPOINT': 'http://localhost:18333',
        'STORAGE_KEY_PREFIX': '',
    },
    resource_deps=['database-ready', 'storage-ready'],
    labels=['api'],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
)

local_resource(
    'api-server',
    serve_cmd='portless api.repro moon run repro/api-server:dev',
    serve_dir=PROJECT_ROOT,
    serve_env={
        'DB_HOST': 'localhost',
        'DB_PORT': '15432',
        'DB_NAME': 'repro',
        'DB_USER': 'repro',
        'DB_PASSWORD': 'repro',
        'STORAGE_ENDPOINT': 'http://localhost:18333',
        'STORAGE_KEY_PREFIX': '',
        'REPRO_APP_URL': 'https://app.repro.localhost:1355',
        'REPRO_API_URL': 'https://api.repro.localhost:1355',
        'OPENROUTER_API_KEY': os.getenv('OPENROUTER_API_KEY', ''),
        'BILLING_DEFAULT_PLAN': 'Free',
        'GOOGLE_CLIENT_ID': os.getenv('GOOGLE_CLIENT_ID', ''),
        'GOOGLE_CLIENT_SECRET': os.getenv('GOOGLE_CLIENT_SECRET', ''),
        'LINEAR_CLIENT_ID': os.getenv('LINEAR_CLIENT_ID', ''),
        'LINEAR_CLIENT_SECRET': os.getenv('LINEAR_CLIENT_SECRET', ''),
        'RATE_LIMIT_REDIS_URL': 'redis://localhost:6379',
        'AGENTIC_RATE_LIMIT_PER_HOUR': '60',
        'AGENTIC_MAX_MESSAGES_PER_RECORDING': '200',
        'OUTBOX_WORKER_DEFAULT_MAX_ATTEMPTS': '3',
        'OUTBOX_WORKER_STALE_AFTER_MS': '300000',
    },
    deps=[
        os.path.join(PROJECT_ROOT, 'apps/api-server/src'),
        os.path.join(PROJECT_ROOT, 'apps/api-server/package.json'),
    ],
    resource_deps=['api-server-migrations', 'portless-proxy', 'redis-ready'],
    allow_parallel=True,
    links=['https://api.repro.localhost:1355'],
    labels=['api'],
)

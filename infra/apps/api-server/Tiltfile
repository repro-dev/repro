PROJECT_ROOT = os.path.join(os.getcwd(), '../../..')

local_resource(
    'api-server-migrations',
    cmd='moon run repro/api-server:migrate',
    dir=PROJECT_ROOT,
    env={
        'DB_HOST': 'localhost',
        'DB_PORT': '15432',
        'DB_NAME': 'repro',
        'DB_USER': 'repro',
        'DB_PASSWORD': 'repro',
    },
    resource_deps=['database-ready', 'storage-ready'],
    labels=['api'],
)

local_resource(
    'db-reset',
    cmd='pnpm --filter @repro/api-server run reset-db',
    dir=PROJECT_ROOT,
    resource_deps=['database-ready', 'storage-ready'],
    labels=['api'],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
)

local_resource(
    'db-seed',
    cmd='pnpm --filter @repro/api-server run seed',
    dir=PROJECT_ROOT,
    resource_deps=['database-ready', 'storage-ready'],
    labels=['api'],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
)

local_resource(
    'api-server',
    serve_cmd='portless api.repro moon run repro/api-server:dev',
    serve_dir=PROJECT_ROOT,
    serve_env={
        'DB_HOST': 'localhost',
        'DB_PORT': '15432',
        'DB_NAME': 'repro',
        'DB_USER': 'repro',
        'DB_PASSWORD': 'repro',
        'STORAGE_ENDPOINT': 'http://localhost:18333',
        'REPRO_APP_URL': 'http://app.repro.localhost:1355',
        'REPRO_API_URL': 'http://api.repro.localhost:1355',
        'OPENROUTER_API_KEY': os.getenv('OPENROUTER_API_KEY', ''),
    },
    deps=[
        os.path.join(PROJECT_ROOT, 'apps/api-server/src'),
        os.path.join(PROJECT_ROOT, 'apps/api-server/package.json'),
    ],
    resource_deps=['api-server-migrations', 'portless-proxy'],
    allow_parallel=True,
    links=['http://api.repro.localhost:1355'],
    labels=['api'],
)

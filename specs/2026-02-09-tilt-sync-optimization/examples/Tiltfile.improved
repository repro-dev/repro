# IMPROVED VERSION: Optimized Docker sync for api-server
# 
# Changes from original:
# 1. target="api-server" instead of "build-all" (builds only api-server, not all packages)
# 2. Expanded ignore patterns (excludes unrelated apps, tests, docs)
# 3. App-specific sync scope (only api-server/src and packages/)
# 4. Transitive dependency watching via moon project-graph

PROJECT_ROOT = os.path.join(os.getcwd(), '../../..')

# Compute full transitive dependency closure using Moon's project graph.
# Returns all @repro/* package names that api-server depends on (direct + transitive).
def compute_all_dependencies(project_id):
  result = local(
    'moon project-graph %s --json' % project_id,
    quiet=True,
  )
  graph = decode_json(str(result))
  nodes = graph.get('graph', {}).get('nodes', [])
  deps = []
  for node in nodes:
    node_id = node.get('id', '')
    if node_id == project_id:
      continue
    if node_id.startswith('repro/'):
      deps.append(node_id.replace('repro/', '', 1))
  return deps

ALL_DEPS = compute_all_dependencies('repro/api-server')

docker_build(
  'api-server',
  PROJECT_ROOT,
  dockerfile='../../Dockerfile',
  target='api-server',
  entrypoint=["moon", "run", "repro/api-server:dev"],
  ignore=[
    'infra',
    'dist',
    'build',
    'node_modules',
    'apps/capture/**',
    'apps/workspace/**',
    'apps/admin/**',
    'apps/devtools-demo/**',
    'apps/storybook-ui/**',
    '**/*.test.ts',
    '**/*.test.tsx',
    '**/*.spec.ts',
    '**/*.spec.tsx',
    '**/fixtures/**',
    '**/mocks/**',
    '**/test-data/**',
    '**/*.stories.tsx',
    '**/*.stories.ts',
    '**/*.demo.tsx',
    '**/*.md',
    '*.md',
    '*.MD',
    '.DS_Store',
    '*.swp',
    '*.swo',
    '*~',
    '*.log',
  ],
  live_update=[
    fall_back_on([
      os.path.join(PROJECT_ROOT, 'apps/api-server/package.json'),
      os.path.join(PROJECT_ROOT, 'apps/api-server/moon.yml'),
      os.path.join(PROJECT_ROOT, 'apps/api-server/tsconfig.json'),
    ] + [
      os.path.join(PROJECT_ROOT, 'packages/' + dep + '/package.json')
      for dep in ALL_DEPS
    ] + [
      os.path.join(PROJECT_ROOT, 'pnpm-lock.yaml'),
    ]),
    sync(
      os.path.join(PROJECT_ROOT, 'apps/api-server/src'),
      '/app/apps/api-server/src'
    ),
    sync(
      os.path.join(PROJECT_ROOT, 'packages'),
      '/app/packages'
    ),
  ]
)

k8s_yaml(helm(
  './chart',
  name='api-server',
  set=[
    'container.image=api-server',
    'vars.REPRO_APP_URL=http://app.repro.localhost',
    'vars.REPRO_API_URL=http://api.repro.localhost',
    'vars.PORT=8080',
    'vars.OPENROUTER_API_KEY=' + os.getenv('OPENROUTER_API_KEY', ''),
  ]
))

k8s_resource(
  'api-server-deployment',
  new_name='api-server',
  links=[
    'http://api.repro.localhost',
  ],
  labels=['api']
)

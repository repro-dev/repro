{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  // Compression settings tuned for the conservative openai/gpt-5.4-mini ceiling.
  //
  // The model exposes a 400k input window. OpenCode reserves 20k for output,
  // leaving about 380k usable tokens before provider-side auto-compaction.
  //
  // Keep DCP well below that gate so compression starts early without being
  // as aggressive as the old 85k/45k setup.
  "compress": {
    // Use range mode: compress completed spans into summaries.
    // Message mode is experimental and untested in our workflow.
    "mode": "range",
    // Soft upper threshold — above this DCP injects strong compression nudges.
    "maxContextLimit": 300000,
    // Soft lower threshold — below this, reminders are off.
    "minContextLimit": 160000,
    // Append bash outputs to compression summaries so file-write operations
    // are never silently dropped from context.
    "protectedTools": ["bash"],
  },
  // Subagent support is experimental — leave disabled until validated
  // with our develop/test agent delegation pattern.
  "experimental": {
    "allowSubAgents": false,
  },
}

#!/usr/bin/env bash
#
# bin/pen — wrapper that injects PEN_CLI_KEY from envchain before calling pen
#
# The repo's .envrc adds bin/ to PATH, so `pen` is available as a bare
# command inside the repo and every worktree.
#
# Setup (one-time):
#   envchain --set pen PEN_CLI_KEY

resolve_path() {
  local target="$1"
  while [ -L "$target" ]; do
    local dir
    dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$target"
}

# Inject PEN_CLI_KEY from the envchain "pen" namespace when it isn't
# already present in the environment (CI, direnv, etc.) and envchain is
# installed. Falls through to a direct exec otherwise, so the CLI's own
# auth error still applies on machines without envchain.
if [[ -z "${PEN_CLI_KEY:-}" ]] && command -v envchain > /dev/null 2>&1; then
  exec envchain pen pen "$@"
fi

exec pen "$@"

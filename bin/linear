#!/usr/bin/env bash
#
# bin/linear — self-locating wrapper for scripts/linear.sh
#
# The repo's .envrc adds bin/ to PATH, so `linear` is available as a bare
# command inside the repo and every worktree.

resolve_path() {
  local target="$1"
  while [ -L "$target" ]; do
    local dir
    dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$target"
}

CALLER_PWD="${PWD}"
export CALLER_PWD

REAL_SCRIPT="$(resolve_path "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Inject LINEAR_API_KEY from the envchain "linear" namespace when it isn't
# already present in the environment (CI, direnv, etc.) and envchain is
# installed. Falls through to a direct exec otherwise, so the CLI's own
# "Missing Linear API key" guidance still applies on machines without envchain.
if [[ -z "${LINEAR_API_KEY:-}" ]] && command -v envchain > /dev/null 2>&1; then
  exec envchain linear "$REPO_ROOT/scripts/linear.sh" "$@"
fi

exec "$REPO_ROOT/scripts/linear.sh" "$@"

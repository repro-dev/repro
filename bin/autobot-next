#!/usr/bin/env bash
#
# bin/autobot-next — self-locating wrapper for packages/autobot-cli/bin/autobot-next
#
# The repo's .envrc adds bin/ to PATH, so `autobot-next` is available as a bare
# command inside the repo and every worktree.

resolve_path() {
  local target="$1"
  while [ -L "$target" ]; do
    local dir
    dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$target"
}

CALLER_PWD="${PWD}"
export CALLER_PWD

REAL_SCRIPT="$(resolve_path "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

exec "$REPO_ROOT/packages/autobot-cli/bin/autobot-next" "$@"

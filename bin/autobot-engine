#!/usr/bin/env bash
#
# bin/autobot-engine — self-locating wrapper for scripts/autobot-engine.sh
#
# The repo's .envrc adds bin/ to PATH, so `autobot-engine` is available as a
# bare command when you cd into the repo or a worktree.

resolve_path() {
  local target="$1"
  while [ -L "$target" ]; do
    local dir
    dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$target"
}

CALLER_PWD="${PWD}"
export CALLER_PWD

REAL_SCRIPT="$(resolve_path "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

exec "$REPO_ROOT/scripts/autobot-engine.sh" "$@"

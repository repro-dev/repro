#!/usr/bin/env bash
#
# bin/reproctl — self-locating wrapper for scripts/reproctl.sh
#
# The repo's .envrc adds bin/ to PATH via direnv, so `reproctl` is
# available as a bare command when you cd into the repo or a worktree.
#
# Setup (one-time):
#   brew bundle && eval "$(direnv hook zsh)" >> ~/.zshrc && direnv allow
#
# This wrapper resolves its own filesystem location (following symlinks)
# to find scripts/reproctl.sh, so it works from any cwd — including
# worktrees, which each get their own tracked copy of this file.

resolve_path() {
  local target="$1"
  # Follow symlinks to the real file. macOS doesn't have readlink -f
  # by default, so we loop manually.
  while [ -L "$target" ]; do
    local dir
    dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    # Handle relative symlinks
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$target"
}

REAL_SCRIPT="$(resolve_path "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

exec "$REPO_ROOT/scripts/reproctl.sh" "$@"

# DEPENDENCIES
node_modules
.nx-cache

# BUILD
dist
.next/
tsconfig.tsbuildinfo

# ENVIRONMENT
.env*
!.envrc

# WORKSPACE
.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# PNPM
# Branch-specific lockfiles created by gitBranchLockfile setting.
# Only the main pnpm-lock.yaml should be committed.
pnpm-lock.*.yaml

# MOON
.moon/cache
.moon/docker

# STORYBOOK
*storybook.log
storybook-static

# PLAYWRIGHT
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# PYTHON
__pycache__/
*.pyc
.pytest_cache/

# LOCAL CERTS
infra/certs/

# TEMP
.DS_Store
/tmp/*
!/tmp/.gitkeep

# GENERATED SOURCES
# Root fmt:check uses this file as Prettier's ignore-path, so mirror generated
# TS artifacts that are only ignored in package-local .gitignore files.
packages/domain/src/generated
packages/wire-formats/src/generated
packages/tdl/src/cli/*.ohm-bundle.*

# JCODEMUNCH
# Local symbol index — generated per-worktree, never committed
.jcodemunch-index/

# OPENCODE
# npm lockfile generated as side-effect when npm is used instead of Bun in .opencode/
.opencode/package-lock.json
# Machine-local direnv overrides written by `reproctl setup` (e.g. OPENCODE_CONFIG_CONTENT)
.envrc.local
.linear

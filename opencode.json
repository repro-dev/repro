{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "doom_loop": "allow"
  },
  "plugin": ["opencode-pty"],
  "mcp": {
    "Linear": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "Playwright": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"]
    },
    "jcodemunch": {
      "enabled": true,
      "type": "local",
      "command": ["uvx", "jcodemunch-mcp"]
    }
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "typescript", "oxc", "react"],
  "ignorePatterns": [
    "**/dist",
    "**/storybook-static",
    "packages/domain/generated",
    "packages/domain/src/generated",
    "packages/wire-formats/generated",
    "packages/wire-formats/src/generated",
    "packages/tdl/src/cli/*.ohm-bundle.*",
    ".opencode/skills/impeccable/**"
  ],
  "jsPlugins": [
    "./packages/oxlint-plugin-design/dist/plugin.js"
  ],
  "rules": {
    "react/forbid-elements": ["error", { "forbid": ["div", "span"] }],
    "react/forbid-dom-props": ["error", { "forbid": ["style"] }],
    "@repro/oxlint-plugin-design/no-hardcoded-color": "error",
    "@repro/oxlint-plugin-design/no-hardcoded-spacing": "error",
    "@repro/oxlint-plugin-design/no-raw-palette": "error",
    "@repro/oxlint-plugin-design/no-classname-prop": "error"
  },
  "overrides": [
    {
      "files": [
        "*.test.tsx",
        "*.test.ts",
        "**/__tests__/**",
        "*.stories.tsx",
        "*.stories.ts",
        "packages/design/src/tokens/**"
      ],
      "rules": {
        "react/forbid-elements": "off",
        "react/forbid-dom-props": "off",
        "@repro/oxlint-plugin-design/no-hardcoded-color": "off",
        "@repro/oxlint-plugin-design/no-hardcoded-spacing": "off",
        "@repro/oxlint-plugin-design/no-raw-palette": "off",
        "@repro/oxlint-plugin-design/no-classname-prop": "off"
      }
    },
    {
      "files": [
        "packages/design/src/**"
      ],
      "rules": {
        "react/forbid-elements": "off",
        "react/forbid-dom-props": "off"
      }
    },
    {
      "files": [
        "apps/marketing/**"
      ],
      "rules": {
        "@repro/oxlint-plugin-design/no-classname-prop": "off"
      }
    }
  ]
}

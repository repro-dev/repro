              "children": [
                {
                  "type": "frame",
                  "id": "s-signup",
                  "name": "Eval: Signup",
                  "x": 0,
                  "y": 0,
                  "width": 640,
                  "height": 480,
                  "metadata": {
                    "type": "screen",
                    "stateFamily": "screens/eval-fixture/signup",
                    "state": "content"

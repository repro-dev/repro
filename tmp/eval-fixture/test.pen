                      "x": 0,
                      "y": 0,
                      "width": 120,
                      "height": 44,
                      "fill": "$color-success",
                      "descendants": {
                        "n-label": {
                          "content": "Create account"
                        }
                      }
                    },
                    {
                      "type": "ref",
                      "id": "r-legacy",

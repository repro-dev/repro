                  "x": 0,
                  "y": 0,
                  "width": 100,
                  "height": 20,
                  "fill": "$color-text-default"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "id": "g-screens",
      "name": "screens",

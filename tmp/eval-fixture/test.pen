                      "y": 0,
                      "width": 120,
                      "height": 36,
                      "fill": "#FF00FF",
                      "descendants": {
                        "n-label": {
                          "content": "Beta"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "s-signup-loading",

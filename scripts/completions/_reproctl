#compdef reproctl
# shellcheck disable=SC2168,SC2207,SC2034
#
# Zsh completion for reproctl — the Repro development CLI.
#
# Installation (add to ~/.zshrc BEFORE compinit):
#   fpath=(/path/to/repro/scripts/completions $fpath)
#
# Or, if direnv is already configured, the .envrc sources this
# automatically. Just run:  compinit

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Locate the repo root relative to this completion file.
__reproctl_repo_root() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)"
  if [[ -n "$root" ]]; then
    echo "$root"
    return
  fi

  local dir="${${(%):-%x}:A:h}"
  echo "${dir:h:h}"
}

# List service names from infra/services.json.
__reproctl_services() {
  local repo
  repo="$(__reproctl_repo_root)"
  local json="$repo/infra/services.json"
  [[ -f "$json" ]] || return
  python3 "$repo/scripts/lib/py/service_names.py" "$json" 2>/dev/null
}

__reproctl_launchable_services() {
  local repo
  repo="$(__reproctl_repo_root)"
  local json="$repo/infra/services.json"
  [[ -f "$json" ]] || return
  python3 "$repo/scripts/lib/py/launchable_local_services.py" "$json" 2>/dev/null
}

# List worktree branch slugs (stripped of repro-wt- prefix).
__reproctl_worktree_branches() {
  git worktree list --porcelain 2>/dev/null \
    | awk '/^branch refs\/heads\//{sub(/^branch refs\/heads\//, ""); print}'
}

# ---------------------------------------------------------------------------
# Main completion function
# ---------------------------------------------------------------------------

_reproctl() {
  local -a top_commands
  top_commands=(
    'setup:Bootstrap the development environment'
    'doctor:Check development prerequisites'
    'checkhealth:Runtime health checks'
    'cluster:Manage local k8s cluster and registry'
    'db:Database operations'
    'code-index:Code intelligence index management'
    'herdr:Open the current checkout in Herdr'
    'start:Start services'
    'stop:Stop services or tear down Tilt'
    'restart:Rebuild and redeploy services'
    'status:Show running services'
    'logs:Show or stream service logs'
    'ui:Open Tilt dashboard in browser'
    'launch:Open a service URL in the browser'
    'context:Show current development context'
    'worktree:Manage git worktrees'
    'wt:Manage git worktrees (alias)'
    'completion:Generate shell completions'
    'version:Print the reproctl commit and date'
    'help:Show help for a command'
    'opencode:Launch OpenCode with optional model profile'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(--version -V)'{--version,-V}'[Print version]' \
    '--json[Output machine-readable JSON]' \
    '(--quiet -q)'{--quiet,-q}'[Suppress non-error output]' \
    '--verbose[Show diagnostic details]' \
    '1:command:->command' \
    '*::arg:->args' && return

  case "$state" in
    command)
      _describe -t commands 'reproctl command' top_commands
      ;;
    args)
      case "${line[1]}" in
        setup)      _reproctl_setup ;;
        doctor)     ;; # no args
        checkhealth) _reproctl_checkhealth ;;
        cluster)    _reproctl_cluster ;;
        db)         _reproctl_db ;;
        code-index) _reproctl_code_index ;;
        herdr)      _reproctl_herdr ;;
        start)      _reproctl_start ;;
        stop)       _reproctl_stop ;;
        restart)    _reproctl_restart ;;
        status)     ;; # no args
        logs)       _reproctl_logs ;;
        ui)         ;; # no args
        launch)     _reproctl_launch ;;
        context)    ;; # no args
        worktree|wt) _reproctl_worktree ;;
        completion) _reproctl_completion ;;
        version)    _reproctl_version ;;
        help)       _reproctl_help ;;
        opencode)   _reproctl_opencode ;;
      esac
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Subcommand completions
# ---------------------------------------------------------------------------

_reproctl_setup() {
  _arguments \
    '--skip-cluster[Skip kind cluster creation]' \
    '--open-herdr[Open the current checkout in Herdr after bootstrap]' \
    '(-h --help)'{-h,--help}'[Show help]'
}

_reproctl_herdr() {
  local -a herdr_commands
  herdr_commands=(
    'open:Open or reuse the current checkout in Herdr'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:subcommand:->subcommand' \
    '*::arg:->args' && return

  case "$state" in
    subcommand) _describe -t commands 'herdr subcommand' herdr_commands ;;
    args)
      case "${line[1]}" in
        open) _arguments '(-h --help)'{-h,--help}'[Show help]' ;;
      esac
      ;;
  esac
}

_reproctl_checkhealth() {
  _arguments \
    '(-h --help)'{-h,--help}'[Show help]'
}

_reproctl_cluster() {
  local -a cluster_commands
  cluster_commands=(
    'up:Create local registry and kind cluster'
    'down:Tear down cluster and registry'
    'status:Show cluster and registry state'
    'reset:Destroy and recreate the cluster'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:subcommand:->subcommand' \
    '*::arg:->args' && return

  case "$state" in
    subcommand) _describe -t commands 'cluster subcommand' cluster_commands ;;
    args)
      case "${line[1]}" in
        down|reset) _arguments '--force[Force even if services are running]' ;;
      esac
      ;;
  esac
}

_reproctl_db() {
  local -a db_commands
  db_commands=(
    'reset:Drop and recreate the database'
    'migrate:Run pending migrations'
    'shell:Open a psql session'
    'status:Show connection info and migration status'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:subcommand:->subcommand' \
    '*::arg:->args' && return

  case "$state" in
    subcommand) _describe -t commands 'db subcommand' db_commands ;;
    args)
      case "${line[1]}" in
        reset) _arguments '(-y --yes)'{-y,--yes}'[Skip confirmation]' ;;
      esac
      ;;
  esac
}

_reproctl_code_index() {
  local -a code_index_commands
  code_index_commands=(
    'help:Show usage summary'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:subcommand:->subcommand' && return

  case "$state" in
    subcommand) _describe -t commands 'code-index subcommand' code_index_commands ;;
  esac
}

# Complete service names (for start, logs, etc.)
_reproctl_services_arg() {
  local -a services
  services=("${(@f)$(__reproctl_services)}")
  [[ ${#services} -gt 0 ]] && _values -s ' ' 'service' "${services[@]}"
}

_reproctl_start() {
  _arguments \
    '(--pick -p)'{--pick,-p}'[Interactively select a service]' \
    '(--wait -w)'{--wait,-w}'[Block until all services are healthy]' \
    '(--timeout -t)'{--timeout,-t}'[Timeout for --wait (no default)]:duration:' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '*:service:_reproctl_services_arg'
}

_reproctl_stop() {
  _arguments \
    '--all[Tear down Tilt entirely]' \
    '(--worktree -w)'{--worktree,-w}'[Target a specific worktree]:branch:__reproctl_worktree_branches' \
    '(--pick -p)'{--pick,-p}'[Interactively select a service]' \
    '*:service:_reproctl_services_arg'
}

_reproctl_restart() {
  _arguments \
    '--all[Restart entire Tilt daemon]' \
    '(--worktree -w)'{--worktree,-w}'[Target a specific worktree]:branch:__reproctl_worktree_branches' \
    '(--pick -p)'{--pick,-p}'[Interactively select a service]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '*:service:_reproctl_services_arg'
}

_reproctl_logs() {
  _arguments \
    '(-f --follow)'{-f,--follow}'[Stream logs continuously]' \
    '--level[Filter by level]:level:(warn error)' \
    '--source[Filter by source]:source:(all build runtime)' \
    '--grep[Filter lines matching pattern]:pattern:' \
    '(-C --context)'{-C,--context}'[Time window around matches]:duration:' \
    '-B[Time window before matches]:duration:' \
    '-A[Time window after matches]:duration:' \
    '--since[Show logs newer than]:duration or timestamp:' \
    '--json[Output structured JSON]' \
    '--no-prefix[Omit resource name prefix]' \
    '(-n --tail)'{-n,--tail}'[Show last N lines]:lines:' \
    '(--pick -p)'{--pick,-p}'[Interactively select a service]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '*:service:_reproctl_services_arg'
}


_reproctl_launch() {
  local -a launch_services
  launch_services=(${(f)"$(__reproctl_launchable_services)"})
  _arguments \
    '(--worktree -w)'{--worktree,-w}'[Target a specific worktree]:branch:__reproctl_worktree_branches' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:service:'"(${launch_services[*]})"
}


_reproctl_worktree() {
  local -a wt_commands
  wt_commands=(
    'create:Create a new worktree'
    'remove:Remove a worktree'
    'list:List active worktrees'
    'attach:Drop into a worktree subshell'
    'prune:Remove worktrees with merged branches'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:subcommand:->subcommand' \
    '*::arg:->args' && return

  case "$state" in
    subcommand) _describe -t commands 'worktree subcommand' wt_commands ;;
    args)
      case "${line[1]}" in
        create)
          _arguments \
            '(--from-issue -i)'{--from-issue,-i}'[Fetch branch from Linear issue]:issue id:' \
            '--no-status-update[Skip setting issue to In Progress]' \
            '--skip-install[Skip pnpm install and moon run :build]' \
            '--dry-run[Preview without making changes]' \
            '(-h --help)'{-h,--help}'[Show help]' \
            '1:branch name:'
          ;;
        remove)
          _arguments \
            '--dry-run[Preview without making changes]' \
            '(-h --help)'{-h,--help}'[Show help]' \
            '1:branch:->branch' && return
          [[ "$state" == branch ]] && {
            local -a branches
            branches=("${(@f)$(__reproctl_worktree_branches)}")
            [[ ${#branches} -gt 0 ]] && compadd -a branches
          }
          ;;
        attach)
          local -a branches
          branches=("${(@f)$(__reproctl_worktree_branches)}")
          [[ ${#branches} -gt 0 ]] && compadd -a branches
          ;;
        prune)
          _arguments \
            '--dry-run[Preview without making changes]' \
            '(-y --yes)'{-y,--yes}'[Skip confirmation]' \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
      esac
      ;;
  esac
}

_reproctl_completion() {
  local -a shells
  shells=(
    'bash:Generate Bash completions'
    'zsh:Generate Zsh completions'
    'fish:Generate Fish completions'
  )
  _describe -t shells 'shell' shells
}

_reproctl_version() {
  _arguments \
    '--json[Output structured JSON]' \
    '(-h --help)'{-h,--help}'[Show help]'
}

_reproctl_help() {
  local -a help_topics
  help_topics=(
    'setup' 'doctor' 'checkhealth' 'cluster' 'db' 'code-index'
    'start' 'stop' 'restart' 'status' 'logs'
    'ui' 'launch' 'context' 'worktree' 'wt'
    'completion' 'version' 'herdr' 'opencode'
    'environment' 'exit-codes' 'json'
  )
  compadd -a help_topics
}

# Complete profile names from .opencode/profiles/*.json
__reproctl_opencode_profiles() {
  local repo
  repo="$(__reproctl_repo_root)"
  local -a profiles
  local f
  for f in "$repo/.opencode/profiles/"*.json; do
    [[ -f "$f" ]] && profiles+=("${f:t:r}")
  done
  echo "${profiles[@]}"
}

_reproctl_opencode() {
  local -a profiles
  profiles=(${(f)"$(__reproctl_opencode_profiles)"})

  _arguments \
    '--profile[Model profile name]:profile:('"${profiles[*]}"')' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '*:opencode args:'
}

if [[ "${funcstack[1]}" == _reproctl ]]; then
  _reproctl "$@"
else
  compdef _reproctl reproctl
fi
